# Cloud Build context (repo root via cloud-run/deploy.sh) — keep uploads small.
# Mirror cloud-run/.dockerignore; only cloud-run/ + supabase/migrations/ reach the image.

.git/
.github/
.cursor/
agent-workspace/

# Frontend / Vercel (not in Cloud Run image)
node_modules/
build/
dist/
.vercel/
.react-router/
src/
api/
public/
package-lock.json
vite.config.ts
react-router.config.ts
vercel.json
tsconfig.json
vitest.config.mts

# Playwright + app tests
tests/
playwright-report/
.auth/

# Docs / design packs (large; not needed in pipeline image)
artifacts/

# Python — local venv and test suite must never upload
cloud-run/.venv/
cloud-run/tests/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/*.pyc
.pytest_cache/

# Supabase — only migration SQL is COPY'd in Dockerfile
supabase/functions/

# Env / secrets
.env
.env.*
